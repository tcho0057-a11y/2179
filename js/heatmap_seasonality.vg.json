{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#f8f9fb",

  "title": {
    "text": "When Australians Travel",
    "subtitle": "Monthly overseas departure patterns",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "color": "#1f2937",
    "subtitleColor": "#6b7280"
  },

  "width": 650,
  "height": 160,

  "data": {
    "values": [
      {"year": "2025", "month": "Sep", "departures": 950000},
      {"year": "2025", "month": "Oct", "departures": 1020000},
      {"year": "2025", "month": "Nov", "departures": 1100000},
      {"year": "2025", "month": "Dec", "departures": 1350000},
      {"year": "2026", "month": "Jan", "departures": 1420000},
      {"year": "2026", "month": "Feb", "departures": 1210000},
      {"year": "2026", "month": "Mar", "departures": 1180000}
    ]
  },

  "mark": {
    "type": "rect",
    "stroke": "#f8f9fb",
    "strokeWidth": 3
  },

  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "sort": ["Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"],
      "title": "Month"
    },

    "y": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },

    "color": {
      "field": "departures",
      "type": "quantitative",
      "title": "Departures",
      "scale": {
        "scheme": "blues"
      },
      "legend": {
        "format": "~s"
      }
    },

    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "month", "type": "ordinal", "title": "Month"},
      {"field": "departures", "type": "quantitative", "title": "Departures", "format": ","}
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}