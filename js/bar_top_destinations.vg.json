{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "background": "#f8f9fb",

  "title": {
    "text": "Top Overseas Destinations",
    "subtitle": "Most visited countries by Australians",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "color": "#1f2937",
    "subtitleColor": "#6b7280"
  },

  "width": "container",
  "height": 350,

  "data": {
    "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/data/top_destinations.csv"
  },

  "transform": [
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "departures", "order": "descending"}]
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#2171b5",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelColor": "#1f2937"
          }
        },
        "x": {
          "field": "departures",
          "type": "quantitative",
          "title": "Australian Travellers",
          "axis": {
            "values": [0, 20000, 40000, 60000, 80000, 100000, 120000],
            "labelExpr": "datum.value / 1000 + 'k'",
            "gridColor": "#e5e7eb"
          }
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "departures", "type": "quantitative", "title": "Departures", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#7285A5"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "departures",
          "type": "quantitative"
        },
        "text": {
          "field": "departures",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ],

  "config": {
    "view": {"stroke": null}
  }
}