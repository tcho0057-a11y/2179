{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#f8f9fb",

  "title": {
    "text": "Where Australians Travel Overseas",
    "subtitle": "Use the slider to filter destinations by traveller volume",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "color": "#1f2937",
    "subtitleColor": "#6b7280"
  },

  "width": "container",
  "height": 320,

  "params": [
    {
      "name": "minTravellers",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 140000,
        "step": 10000,
        "name": "Minimum travellers: "
      }
    }
  ],

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7e3dc",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/data/top_destinations.csv"
      },

      "transform": [
        {
          "filter": "datum.departures >= minTravellers"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "departures",
          "type": "quantitative",
          "scale": {
            "range": [120, 3200]
          },
          "legend": null
        },

        "color": {
          "value": "#156082"
        },

        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "departures",
            "type": "quantitative",
            "title": "Travellers",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}