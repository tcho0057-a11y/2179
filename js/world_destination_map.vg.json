{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#f8f9fb",

  "title": {
    "text": "Where Australians Travel Overseas",
    "subtitle": "Bubble size represents short-term resident returns",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "color": "#1f2937",
    "subtitleColor": "#6b7280"
  },

  "width": 650,
  "height": 360,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e2ddd4",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/data/top_destinations.csv"
      },

      "transform": [
        {
          "calculate": "toNumber(datum.longitude)",
          "as": "lon"
        },
        {
          "calculate": "toNumber(datum.latitude)",
          "as": "lat"
        },
        {
          "calculate": "toNumber(datum.departures)",
          "as": "travellers"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "travellers",
          "type": "quantitative",
          "scale": {
            "range": [80, 2000]
          },
          "legend": {
            "title": "Travellers",
            "format": "~s"
          }
        },
        "color": {
          "field": "travellers",
          "type": "quantitative",
          "scale": {
            "scheme": "blues"
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "travellers",
            "type": "quantitative",
            "title": "Travellers",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}