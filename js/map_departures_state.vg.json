{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "background": "#f8f9fb",

  "title": {
    "text": "Australian Overseas Departures by State",
    "subtitle": "Departures per capita · February 2026",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 22,
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "offset": 15,
    "color": "#1f2937",
    "subtitleColor": "#4b5563"
  },

  "width": "container",
  "height": 250,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/js/Map_Australia_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },

      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/data/departures_by_state.csv"
            },
            "key": "state_name",
            "fields": ["departures", "population"]
          }
        },
        {
          "calculate": "datum.departures / datum.population",
          "as": "departures_per_capita"
        },
        {
          "calculate": "format(datum.departures, ',')",
          "as": "formatted_departures"
        },
        {
          "calculate": "format(datum.population, ',')",
          "as": "formatted_population"
        },
        {
          "calculate": "datum.departures_per_capita < 0.040 ? 'Under 0.040' : datum.departures_per_capita < 0.050 ? '0.040 – 0.050' : datum.departures_per_capita < 0.060 ? '0.050 – 0.060' : datum.departures_per_capita < 0.070 ? '0.060 – 0.070' : '0.070 and above'",
          "as": "rate_bin"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },

      "encoding": {
        "color": {
          "field": "rate_bin",
          "type": "ordinal",
          "title": "Departures per Capita",
          "scale": {
            "domain": [
              "Under 0.040",
              "0.040 – 0.050",
              "0.050 – 0.060",
              "0.060 – 0.070",
              "0.070 and above"
            ],
            "range": [
              "#c6dbef",
              "#9ecae1",
              "#6baed6",
              "#2171b5",
              "#08306b"
            ]
          },
          "legend": {
            "title": "Departures per Capita",
            "orient": "right",
            "titleFontSize": 13,
            "labelFontSize": 11,
            "symbolSize": 200,
            "symbolType": "square"
          }
        },

        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "formatted_departures",
            "type": "nominal",
            "title": "Total Departures"
          },
          {
            "field": "formatted_population",
            "type": "nominal",
            "title": "Population"
          },
          {
            "field": "departures_per_capita",
            "type": "quantitative",
            "title": "Per Capita Rate",
            "format": ".3f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/js/Map_Australia_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#374151",
        "strokeWidth": 0.7
      }
    }
  ],

  "config": {
    "view": { "stroke": null },
    "font": "Arial"
  }
}