{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "background": "#f8f9fb",

  "title": {
    "text": "International vs Domestic Travel Ratio by State",
    "subtitle": "International departures per domestic overnight trip",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "color": "#1f2937",
    "subtitleColor": "#6b7280"
  },

  "width": "container",
  "height": 340,

  "data": {
    "values": [
      {"state": "New South Wales",          "domestic_trips": 10570, "international_departures": 606060},
      {"state": "Victoria",                 "domestic_trips": 8043,  "international_departures": 445790},
      {"state": "Queensland",               "domestic_trips": 6772,  "international_departures": 303250},
      {"state": "Western Australia",        "domestic_trips": 2563,  "international_departures": 204400},
      {"state": "South Australia",          "domestic_trips": 2050,  "international_departures": 62930},
      {"state": "Australian Capital Territory", "domestic_trips": 586, "international_departures": 22200},
      {"state": "Tasmania",                 "domestic_trips": 757,   "international_departures": 18710},
      {"state": "Northern Territory",       "domestic_trips": 214,   "international_departures": 12260}
    ]
  },

  "transform": [
    {
      "calculate": "datum.international_departures / datum.domestic_trips",
      "as": "ratio"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#2171b5",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelColor": "#1f2937"
          }
        },
        "x": {
          "field": "ratio",
          "type": "quantitative",
          "title": "International Departures per Domestic Trip",
          "axis": {
            "gridColor": "#e5e7eb",
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "international_departures", "type": "quantitative", "title": "International Departures", "format": ","},
          {"field": "domestic_trips", "type": "quantitative", "title": "Domestic Trips", "format": ","},
          {"field": "ratio", "type": "quantitative", "title": "Ratio", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": "#4b5563"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "ratio",
          "type": "quantitative"
        },
        "text": {
          "field": "ratio",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {
    "view": {"stroke": null}
  }
}