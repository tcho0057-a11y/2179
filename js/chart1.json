{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "background": "#f8f9fb",

  "title": {
    "text": "Australian Overseas Departures by State",
    "subtitle": "Departures per capita — February 2026",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 22,
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "offset": 15,
    "color": "#1f2937",
    "subtitleColor": "#4b5563"
  },

  "width": 720,
  "height": 430,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/js/Map_Australia_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },

      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/data/departures_by_state.csv"
            },
            "key": "state_name",
            "fields": [
              "departures",
              "population"
            ]
          }
        },

        {
          "calculate": "datum.departures / datum.population",
          "as": "departures_per_capita"
        },

        {
          "calculate": "format(datum.departures, ',')",
          "as": "formatted_departures"
        },

        {
          "calculate": "format(datum.population, ',')",
          "as": "formatted_population"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },

      "encoding": {
        "color": {
          "field": "departures_per_capita",
          "type": "quantitative",

          "scale": {
            "domain": [0.03, 0.075],
            "scheme": "blues"
          },

          "legend": {
            "title": "Departures per Capita",
            "orient": "right",
            "gradientLength": 250,
            "titleFontSize": 13,
            "labelFontSize": 11,
            "format": ".3f"
          }
        },

        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State"
          },

          {
            "field": "formatted_departures",
            "type": "nominal",
            "title": "Total Departures"
          },

          {
            "field": "formatted_population",
            "type": "nominal",
            "title": "Population"
          },

          {
            "field": "departures_per_capita",
            "type": "quantitative",
            "title": "Per Capita Rate",
            "format": ".3f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/tcho0057-a11y/2179/main/js/Map_Australia_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#374151",
        "strokeWidth": 0.7
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Arial"
  }
}