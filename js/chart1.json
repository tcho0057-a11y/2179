{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian Overseas Departures by State (February 2026)",
    "fontSize": 14,
    "font": "Georgia",
    "anchor": "start"
  },
  "width": 700,
  "height": 400,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "js/map_australia_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/departures_by_state.csv"},
            "key": "state_name",
            "fields": ["departures", "population"]
          }
        },
        {
          "calculate": "datum.departures / datum.population",
          "as": "departures_per_capita"
        }
      ],
      "mark": {"type": "geoshape"},
      "encoding": {
        "color": {
          "field": "departures_per_capita",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [0.03, 0.06, 0.09],
            "range": ["#d4eaf7", "#7ab8d9", "#2e7fb8", "#0d3b6b"]
          },
          "title": "Departures per capita"
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "State"},
          {"field": "departures", "type": "quantitative", "title": "Total Departures", "format": ","},
          {"field": "departures_per_capita", "type": "quantitative", "title": "Per Capita", "format": ".3f"}
        ]
      }
    },
    {
      "data": {
        "url": "js/map_australia_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "white",
        "strokeWidth": 0.5
      }
    }
  ]
}