{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "background": "#f8f9fb",

  "title": {
    "text": "Why Do Australians Travel?",
    "subtitle": "Purpose of domestic daytrips, December Quarter 2025",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 30,
    "fontWeight": "bold",
    "subtitleFontSize": 15,
    "color": "#1f2937",
    "subtitleColor": "#6b7280"
  },

  "width": "container",
  "height": 380,

  "data": {
    "values": [
      {"purpose": "Holiday",                      "trips_million": 36.6, "bubble_size": 36.6, "x": 30, "y": 55},
      {"purpose": "Visiting Friends and Relatives","trips_million": 21.5, "bubble_size": 28,   "x": 65, "y": 55},
      {"purpose": "Other",                         "trips_million": 7.6,  "bubble_size": 10,   "x": 52, "y": 30},
      {"purpose": "Business",                      "trips_million": 5.0,  "bubble_size": 7,    "x": 18, "y": 30}
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.93,
        "stroke": "#f8f9fb",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [0, 90]},
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {"domain": [0, 90]},
          "axis": null
        },
        "size": {
          "field": "bubble_size",
          "type": "quantitative",
          "scale": {"range": [7000, 90000]},
          "legend": null
        },
        "color": {
          "field": "purpose",
          "type": "nominal",
          "scale": {
            "domain": ["Holiday", "Visiting Friends and Relatives", "Other", "Business"],
            "range": ["#8ecae6", "#c9dceb", "#0d6e8a", "#2b6ea6"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "purpose",       "type": "nominal",      "title": "Purpose"},
          {"field": "trips_million", "type": "quantitative", "title": "Trips (millions)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Georgia",
        "fontWeight": "bold",
        "fontSize": 15,
        "color": "#ffffff",
        "align": "center",
        "baseline": "middle",
        "dy": -10
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "purpose"}
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Georgia",
        "fontSize": 20,
        "fontWeight": "bold",
        "color": "#ffffff",
        "align": "center",
        "baseline": "middle",
        "dy": 14
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {
          "field": "trips_million",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {
    "view": {"stroke": null}
  }
}